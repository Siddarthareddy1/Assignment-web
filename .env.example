# ==============================================================================
# STUDYPATH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application.
# NEVER commit your actual .env file with private secrets to version control.

# ------------------------------------------------------------------------------
# 1. ANTHROPIC CLAUDE API (Server-Side Secret)
# ------------------------------------------------------------------------------
# Required for Claude-powered curriculum analysis, question generation,
# step-by-step solution explainer, and constructive attempt coaching.
# (If left empty, StudyPath will run in intelligent offline fallback mode)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN & GCP CONFIGURATION (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Used by FastAPI backend for ID token verification and Firestore/Storage Admin operations.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
# Path to service account JSON file for local execution or leave empty to use ADC in Google Cloud Run:
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# 3. REDIS & CELERY CONFIGURATION (Server-Side Secret)
# ------------------------------------------------------------------------------
# Message broker and result backend for asynchronous document processing jobs.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. CORS & NETWORKING
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://studypath.vercel.app"]

# ------------------------------------------------------------------------------
# 5. STORAGE LIMITS & RETENTION POLICY
# ------------------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=100
DOCUMENT_RETENTION_DAYS=30
LOCAL_STORAGE_DIR=./storage_data

# ------------------------------------------------------------------------------
# 6. FIREBASE WEB CLIENT CONFIGURATION (Public Frontend Variables)
# ------------------------------------------------------------------------------
# These variables are bundled into the React client application via Vite.
# They are public identifiers used by Firebase Client SDK for user authentication.
# (DO NOT prefix private server secrets like ANTHROPIC_API_KEY with VITE_)
VITE_BACKEND_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=AIzaSyExampleClientApiKey
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
