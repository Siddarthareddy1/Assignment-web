rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read: if isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isResourceOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isResourceOwner();

      // Nested Document Chunks
      match /chunks/{chunkId} {
        allow read: if isAuthenticated() && (
          resource == null || resource.data.ownerId == request.auth.uid
        );
        allow write: if false; // Server-side admin only writes chunks
      }
    }

    // Practice Sets Collection
    match /practiceSets/{practiceSetId} {
      allow read: if isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isResourceOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isResourceOwner();
    }

    // Attempts Collection
    match /attempts/{attemptId} {
      allow read: if isResourceOwner();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if false; // Attempts are immutable once submitted
      allow delete: if isResourceOwner();
    }

    // Progress Collection
    match /progress/{progressId} {
      allow read: if isResourceOwner();
      allow create, update: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isResourceOwner();
    }

    // Background Job records
    match /jobs/{jobId} {
      allow read: if isResourceOwner();
      allow write: if false; // Server-side worker only writes jobs
    }
  }
}
